# VoxPay Backend Environment Variables
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=voxpay_db
PORT=8000
HOST=0.0.0.0

# Optional: comma-separated list of allowed frontend origins (Leave blank to allow any origin like Vercel)
# e.g., FRONTEND_URL=https://voxpay.vercel.app,http://localhost:5173
FRONTEND_URL=

# Teammate's Live Render ML Service
ML_MODEL_URL=https://voicepay-ai.onrender.com
ML_REQUEST_TIMEOUT_SECONDS=6.0
